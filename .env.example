DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_NAME=db_avisti
DB_USER=root
DB_PASSWORD=
# Local: conexión TCP clásica.
DB_HOST=127.0.0.1
DB_PORT=3306
# Desplegado (App Engine + Cloud SQL): si se define, settings.py usa este
# socket Unix e ignora DB_HOST/DB_PORT. En local dejar vacío.
# Ejemplo: DB_SOCKET_PATH=/cloudsql/PROYECTO:REGION:INSTANCIA
DB_SOCKET_PATH=
# Alias opcional: si solo se define el connection name, settings.py deriva
# el socket como /cloudsql/<CLOUD_SQL_CONNECTION_NAME>.
# Ejemplo: CLOUD_SQL_CONNECTION_NAME=PROYECTO:REGION:INSTANCIA
CLOUD_SQL_CONNECTION_NAME=
IMPORT_MAX_FILE_SIZE_BYTES=10485760
IMPORT_CSV_DELIMITER=,
IMPORT_EXCEL_SHEET_NAME=MOVIMIENTO
IMPORT_REQUIRED_COLUMNS="Registro","Codigo","Serie","Descripcion","Comienzo","Vencimiento","Cliente","Usuario","idalmacen","Fechareg","Documento","Tipodoc","EstadoArtAlqui","GrupoKardex","Entrega","Cierre","Reprinc","Orden","Idmotivo","Reprinc2","cliente final"
AUTH_TOKEN_TTL_HOURS=24
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=False
CORS_PREFLIGHT_MAX_AGE=86400
PAGINATION_DEFAULT_PAGE_SIZE=20
PAGINATION_MAX_PAGE_SIZE=100
SP_IMPORT_EXCEL=sp_importar_excel
SP_IMPORT_CSV=sp_importar_csv
SP_IMPORT_JSON=sp_importar_json